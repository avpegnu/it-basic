---
import '../styles/global.css';
import { tracks, topics, groups, url } from '../lib/content';
import Icon from '../components/Icon.astro';
interface Props {
  title: string;
  description?: string;
  section?: string;
  toc?: { id: string; text: string; depth?: number }[];
  wide?: boolean;
}
const {
  title,
  description = 'Học nền tảng IT, ghi nhớ bằng sơ đồ và luyện phỏng vấn bằng tiếng Việt.',
  section = '',
  toc = [],
  wide = false,
} = Astro.props;
const path = Astro.url.pathname;
const isActive = (p: string) => path === url(p);
---

<!doctype html>
<html lang="vi" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111315" />
    <title>{title==='Tổng quan'?'IT Basic — Hiểu bản chất. Học có hệ thống.':`${title} · IT Basic`}</title>
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <slot name="head" />
    <script is:inline>
      try {
        document.documentElement.dataset.theme = localStorage.getItem('it-basic-theme') || 'dark';
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">
      Đến nội dung chính
    </a>
    <aside class="sidebar" id="navigation" aria-label="Điều hướng chính">
      <a class="brand" href={url('/')}>
        <span class="brand-mark">
          <Icon name="grid" size={23} />
        </span>
        <span>
          IT Basic<small>LEARN. UNDERSTAND. BUILD.</small>
        </span>
      </a>
      <nav>
        <div class="nav-main">
          {[
            ['/', 'Tổng quan', 'grid'],
            ['/learn/', 'Lộ trình học', 'book'],
            ['/handbook/', 'Notes & Interview', 'code'],
            ['/practice/', 'Phòng thực hành', 'lab'],
            ['/saved/', 'Góc học tập', 'bookmark'],
          ].map(([href, label, icon]) => (
            <a
              href={url(href)}
              class:list={{ active: isActive(href) }}
              aria-current={isActive(href) ? 'page' : undefined}
            >
              <Icon name={icon} />
              <span>{label}</span>
            </a>
          ))}
        </div>
        {section === 'learn' ? (
          <>
            <p class="nav-label">HỌC THEO LỘ TRÌNH</p>
            {tracks.map((t, i) => (
              <a
                class:list={{ active: path.startsWith(url(`/learn/${t.id}/`)) }}
                href={url(`/learn/${t.id}/`)}
              >
                <span class="nav-dot"></span>
                <span>{t.title}</span>
                <small>{String(i + 1).padStart(2, '0')}</small>
              </a>
            ))}
          </>
        ) : (
          <>
            {groups.map((g) => (
              <>
                <p class="nav-label">{g.replace(/^\d+ · /, '')}</p>
                {topics
                  .filter((t) => t.group === g)
                  .map((t) => (
                    <a
                      href={url(`/handbook/${t.id}/`)}
                      class:list={{ active: path.startsWith(url(`/handbook/${t.id}/`)) }}
                      aria-current={isActive(`/handbook/${t.id}/`) ? 'page' : undefined}
                    >
                      <span class="nav-dot"></span>
                      <span>{t.title}</span>
                    </a>
                  ))}
              </>
            ))}
          </>
        )}
      </nav>
      <div class="sidebar-footer">
        <a href={url('/about/')}>
          Nguồn & đóng góp <span>↗</span>
        </a>
        <p>Mỗi ngày hiểu thêm một chút.</p>
      </div>
    </aside>
    <div class="mobile-scrim" id="nav-scrim" hidden></div>
    <div class="workspace">
      <header class="topbar">
        <button
          class="icon-button mobile-toggle"
          id="menu-toggle"
          aria-controls="navigation"
          aria-expanded="false"
          aria-label="Mở điều hướng"
        >
          <Icon name="menu" />
        </button>
        <div class="breadcrumb">
          <a href={url('/')}>IT Basic</a>
          <span>/</span>
          <span>{title}</span>
        </div>
        <div class="top-actions">
          <a class="search-link" href={url('/search/')}>
            <Icon name="search" size={17} />
            <span>Tìm kiến thức…</span>
            <kbd>⌘ K</kbd>
          </a>
          <button id="theme-toggle" class="icon-button" aria-label="Đổi giao diện sáng hoặc tối">
            <Icon name="sun" />
          </button>
          <a
            class="icon-button github-link"
            href="https://github.com/avpegnu/it-basic"
            aria-label="Mã nguồn GitHub"
          >
            <Icon name="github" />
          </a>
        </div>
      </header>
      <div class:list={['page-grid', { wide, 'has-toc': toc.length > 0 }]}>
        <main id="main" data-pagefind-body>
          <slot />
        </main>
        {toc.length > 0 && (
          <aside class="page-toc" aria-label="Trong trang này" data-pagefind-ignore>
            <p>TRONG TRANG NÀY</p>
            <nav>
              {toc.map((h) => (
                <a class:list={{ sub: h.depth === 3 }} href={`#${h.id}`}>
                  {h.text}
                </a>
              ))}
            </nav>
            <a class="back-top" href="#main">
              ↑ Về đầu trang
            </a>
          </aside>
        )}
      </div>
      <footer class="site-footer">
        <span>IT Basic · Học để hiểu, hiểu để xây dựng.</span>
        <a href={url('/about/')}>Nguồn tham khảo & cách đóng góp ↗</a>
      </footer>
    </div>
    <noscript>
      <style>
        .mobile-toggle {
          display: none;
        }
        @media (max-width: 760px) {
          .sidebar {
            position: relative;
            transform: none !important;
            visibility: visible !important;
            width: 100%;
            height: auto;
            max-height: 320px;
          }
          .sidebar nav {
            max-height: 220px;
          }
          .sidebar-footer {
            display: none;
          }
          .workspace {
            margin: 0;
          }
        }
      </style>
    </noscript>
    <script>
      import { url } from '../lib/url';
      import { initStudy } from '../lib/study';
      const menu = document.querySelector<HTMLButtonElement>('#menu-toggle')!,
        scrim = document.querySelector<HTMLElement>('#nav-scrim')!;
      function close() {
        const wasOpen = document.body.classList.contains('nav-open');
        document.body.classList.remove('nav-open');
        menu.setAttribute('aria-expanded', 'false');
        scrim.hidden = true;
        if (wasOpen) menu.focus();
      }
      menu.addEventListener('click', () => {
        const open = !document.body.classList.contains('nav-open');
        document.body.classList.toggle('nav-open', open);
        menu.setAttribute('aria-expanded', String(open));
        scrim.hidden = !open;
        if (open) document.querySelector<HTMLElement>('#navigation a')?.focus();
      });
      scrim.addEventListener('click', close);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') close();
        if (e.key === 'Tab' && document.body.classList.contains('nav-open')) {
          const focusable = [
              ...document.querySelectorAll<HTMLElement>('#navigation a,#navigation button'),
            ],
            first = focusable[0],
            last = focusable.at(-1);
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last?.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first?.focus();
          }
        }
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          location.href = url('/search/');
        }
      });
      document.querySelector('#theme-toggle')?.addEventListener('click', () => {
        const t = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = t;
        try {
          localStorage.setItem('it-basic-theme', t);
        } catch {}
      });
      initStudy();
      // Keep the table of contents in sync with reading position.
      const headings = [...document.querySelectorAll('main h2[id],main h3[id]')];
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const e of entries)
              if (e.isIntersecting) {
                document
                  .querySelectorAll('.page-toc a')
                  .forEach((a) =>
                    a.classList.toggle('current', a.getAttribute('href') === '#' + e.target.id),
                  );
              }
          },
          { rootMargin: '-15% 0px -65% 0px' },
        );
        headings.forEach((h) => observer.observe(h));
      }
    </script>
  </body>
</html>
