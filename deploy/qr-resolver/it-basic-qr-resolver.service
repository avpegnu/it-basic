[Unit]
Description=IT Basic QR URL resolver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/it-basic-qr-resolver
ExecStart=/usr/bin/node /opt/it-basic-qr-resolver/server.cjs
Environment=NODE_ENV=production
Environment=PORT=3040
Environment=ALLOWED_ORIGIN=https://it.avpegnu.io.vn
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=192M
TasksMax=64

[Install]
WantedBy=multi-user.target
